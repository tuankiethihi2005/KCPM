{
  "all": false,
  "include": [
    "src/controllers/**/*.js",
    "src/services/**/*.js",
    "src/modules/**/*.js",
    "src/middlewares/**/*.js"
  ],
  "exclude": [
    "src/config/**",
    "**/*.test.js"
  ],
  "reporter": [
    "text",
    "text-summary"
  ],
  "reporterOptions": {
    "text": {
      "maxCols": 200
    }
  },
  "temp-directory": "../.tmp_c8_coverage"
}